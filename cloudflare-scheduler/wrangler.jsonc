{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "oci-hunt-trigger",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "observability": { "enabled": true },
  "triggers": {
    "crons": ["8,23,38,53 * * * *"]
  },
  "vars": {
    "DISPATCH_ENABLED": "false"
  }
}
